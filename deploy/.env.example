# Copy to deploy/.env on the demo server. Never commit real credentials.
ACR_REGISTRY=crpi-gbihc3e57h3o3f2l.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=tencent-ubutun22
BACKEND_TAG=latest
FRONTEND_TAG=latest
# Used only with docker-compose.digest.yml; copy the paired published references.
BACKEND_IMAGE=
FRONTEND_IMAGE=
# Loopback only by default. Public exposure requires an explicit bind address.
WEB_PORT=127.0.0.1:48080
BACKEND_CPUS=0.50
BACKEND_MEMORY=512m
FRONTEND_CPUS=0.25
FRONTEND_MEMORY=96m

# Required. Generate with Django's get_random_secret_key command.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Low-resource demo defaults: SQLite, local keyword fallback, no model download.
DJANGO_SETTINGS_MODULE=cs_career_guide.settings_sqlite
DB_PATH=/data/cs-career-guide.sqlite3
STATIC_ROOT=/data/staticfiles
MEDIA_ROOT=/data/media
LANCEDB_PATH=/data/lancedb
EMBEDDING_ENABLED=False
EMBEDDING_ALLOW_DOWNLOAD=False
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=300

# Optional AI credentials. Leave blank when only validating the deployment.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
CAREER_REPORT_MODEL=
ASR_API_KEY=
ASR_WSS_URL=
ASR_MODEL=
ENABLE_TTS=False
TTS_API_KEY=
TTS_WSS_URL=
TTS_MODEL=
TTS_VOICE=

# Watchtower is disabled by default. The updates profile requires host-admin trust.
# Use a dedicated ACR login directory, never a directory containing unrelated credentials.
DOCKER_CONFIG_DIR=/etc/cs-career-guide/acr

# Optional MySQL profile values. They are required only when using --profile mysql
# and switching DJANGO_SETTINGS_MODULE to cs_career_guide.settings.
DATABASE_NAME=cs_career_guide
DATABASE_USER=cs_career_guide
DATABASE_PASSWORD=
DATABASE_HOST=mysql
DATABASE_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_CPUS=0.50
MYSQL_MEMORY=512m
