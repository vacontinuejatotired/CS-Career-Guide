# Copy to backend/.env. Process environment variables take precedence over this file.
# Required: generate a unique key, then fill in your own database credentials.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=cs_career_guide
DATABASE_USER=cs_career_guide
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_CONN_MAX_AGE=0
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Same-origin deployments do not need cross-origin allowances.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Backend-only secrets. Never put these values in frontend VITE_* variables.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-turbo-2025-07-15
CAREER_REPORT_MODEL=
LLM_TIMEOUT=120

# Optional speech services. Empty API keys reuse LLM_API_KEY.
ASR_API_KEY=
ASR_WSS_URL=
ASR_MODEL=gummy-realtime-v1
ENABLE_TTS=False
TTS_API_KEY=
TTS_WSS_URL=
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang

# Relative paths below resolve from backend/. Absolute paths are also supported.
LANCEDB_PATH=../.runtime/lancedb
# False skips importing/loading the local embedding model and uses keyword retrieval.
EMBEDDING_ENABLED=False
EMBEDDING_DIMENSION=512
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
# False prevents implicit downloads; load only an existing local or Hub-cached model.
EMBEDDING_ALLOW_DOWNLOAD=False
SEARCH_MAX_WORKERS=1
CAREER_REPORT_MAX_WORKERS=1

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=cs-career-guide
CACHE_TIMEOUT=300
SESSION_ENGINE=django.contrib.sessions.backends.db

# Only needed when running reset_password.py; password is never printed.
# RESET_PASSWORD_USERNAME=
# RESET_PASSWORD_PASSWORD=
