# Copy to frontend/.env. VITE_* values are public and fixed at build time.
# Never store API keys, database passwords or SECRET_KEY in this file.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=120000

# The original company search feature uses a separate service, not the Django API.
# Production must proxy /company-api to that service or use its public HTTPS URL.
VITE_COMPANY_API_BASE_URL=/company-api
VITE_COMPANY_API_TIMEOUT_MS=30000

VITE_VAD_ASSET_BASE_URL=/models/vad/
VITE_AVATAR_MODEL_URL=/models/d51675667acfc8a42b8e40d4c3e9799a.glb
# Enable only after backend ENABLE_TTS and speech credentials are configured.
VITE_ENABLE_TTS=False

# Optional compatible geolocation endpoints; keep blank to select cities manually.
# Use an HTTPS endpoint or a backend proxy that keeps provider keys server-side.
VITE_GEOCODING_URL=
VITE_IP_GEOLOCATION_URL=

# DEV_* variables affect npm run dev only. They are not exposed in browser bundles.
DEV_HOST=127.0.0.1
DEV_PORT=3002
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
DEV_COMPANY_API_PROXY_TARGET=http://127.0.0.1:3000
